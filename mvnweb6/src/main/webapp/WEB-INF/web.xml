<?xml version="1.0" encoding="UTF-8"?>

<web-app
    version="4.0"
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:javaee="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    
<security-constraint>
    <web-resource-collection>
        <web-resource-name>Список студентов</web-resource-name>
        <url-pattern>/StudentResult.jsp</url-pattern>
        <http-method>GET</http-method>
        <http-method>POST</http-method>
    </web-resource-collection>
    <auth-constraint>
        <role-name>manager</role-name>
    </auth-constraint>
</security-constraint>

<login-config>
    <auth-method>BASIC</auth-method>
    <realm-name>Students Access</realm-name>
</login-config>

  <display-name>Students 4324 JSP App</display-name>
  
  <request-character-encoding>UTF-8</request-character-encoding>
  <response-character-encoding>UTF-8</response-character-encoding>
  
  <welcome-file-list>
    <welcome-file>StudentList.jsp</welcome-file>
  </welcome-file-list>
  
  <error-page>
    <error-code>404</error-code>
    <location>/ErrorManager.jsp</location>
  </error-page>
  <security-role>
    <role-name>manager</role-name>
</security-role>
</web-app>